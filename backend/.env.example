# ---- PASTE YOUR KEYS HERE (copy this file to .env) ----
# MongoDB Atlas connection string (production) — get it free at mongodb.com/atlas
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/parqco?retryWrites=true&w=majority

# Invent any long random string (openssl rand -hex 32). Used to sign login tokens.
JWT_SECRET=PASTE_A_LONG_RANDOM_STRING_HERE

# Invent any long random string. MUST be identical to API_KEY in firmware/config.h
ESP32_API_KEY=PASTE_A_LONG_RANDOM_STRING_HERE

# URL of the Python ML service (internal URL in docker-compose, public URL in prod)
ML_SERVICE_URL=http://ml-service:8000

# Public URL of the frontend (for CORS). Local dev default below.
CORS_ORIGIN=http://localhost:8080

# First admin account (auto-created on startup if it doesn't exist)
ADMIN_EMAIL=admin@parqco.local
ADMIN_PASSWORD=change-me-immediately

# "true" to simulate sensor data on boot (demo-day safety net)
DEMO_MODE=false

PORT=5000
